{
  "name": "instaformat-obsidian-sync",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.4.1"
  },
  "scripts": {
    "build": "pnpm --filter @instaformat/sync-core build && node esbuild.config.mjs",
    "typecheck": "pnpm --filter @instaformat/sync-core build && tsc --noEmit"
  },
  "dependencies": {
    "@instaformat/sync-core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.27.4",
    "obsidian": "1.5.7",
    "typescript": "5.7.3"
  }
}
